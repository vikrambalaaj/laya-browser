#!/bin/bash
# Jev Browser with local Laya as its decision model.
# Usage: jev-laya run "<task>" <start-url> [jev-browser options]   (or no args: MCP stdio server)
set -u
DIR="$(cd "$(dirname "$0")" && pwd)"
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
PORT="${LAYA_PORT:-8799}"
"$DIR/serve-laya.sh" start >&2 || exit 1
export JEV_PROVIDER=typesafe
export TYPESAFE_API_KEY="${TYPESAFE_API_KEY:-local}"      # server runs without a key; SDK insists one is set
export TYPESAFE_BASE_URL="http://127.0.0.1:${JEV_LAYA_PORT:-8798}"   # shortlist proxy in front of laya-serve
export JEV_BROWSER_MODEL="${JEV_BROWSER_MODEL:-multilingual}"
exec jev-browser "$@"
